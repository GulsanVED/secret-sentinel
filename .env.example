# ---------------------------------------------------------------------------
# GitHub access
# ---------------------------------------------------------------------------
# Strongly recommended: without it GitHub allows only 60 API requests/hour.
# Fine-grained token with "Public repositories (read-only)" is enough for
# public repos; for private repos grant them "Contents: read".
GITHUB_TOKEN=
# The dashboard's "CI runs" tab reads Secret scan results from GitHub Actions.
# For private repos the token also needs "Actions: Read".
# Name of the workflow to read (the `name:` line of the workflow file):
SENTINEL_CI_WORKFLOW=Secret scan
# Minimum seconds between two GitHub calls for one repo's CI runs:
CI_SYNC_MIN_SECONDS=20

# ---------------------------------------------------------------------------
# Real-time push alerts (webhook)
# ---------------------------------------------------------------------------
# Shared secret for the GitHub push webhook. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Put the same value in GitHub: repo Settings -> Webhooks -> Secret.
GITHUB_WEBHOOK_SECRET=

# Auto-register a repo the first time a webhook arrives for it (true/false).
WEBHOOK_AUTO_REGISTER=true
# Also scan pushes to branches other than the monitored one (true/false).
WEBHOOK_SCAN_ALL_BRANCHES=false
# Token required on /webhook/ci calls from CI jobs (optional but recommended).
SENTINEL_TOKEN=

# Optional public tunnel for the webhooks: `pip install ngrok`, then
# `python -m app.serve --ngrok`. Only /webhook/* is reachable through it; the
# dashboard stays on localhost unless NGROK_EXPOSE_DASHBOARD=true.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
NGROK_ENABLED=false
NGROK_EXPOSE_DASHBOARD=false

# Fallback polling interval in seconds, used when no webhook is configured
# (and as a safety net if a webhook delivery is missed). 300 = 5 minutes.
POLL_INTERVAL_SECONDS=300

# ---------------------------------------------------------------------------
# Git-history scanning (finds secrets that were deleted from the code but
# still exist in commit history, where they remain exploitable)
# ---------------------------------------------------------------------------
# Needs the `git` binary on the server. A bare mirror of each repo is kept
# under data/mirrors/ and updated with `git fetch` on later scans.
HISTORY_SCAN_ON_ADD=true
# Re-scan the history whenever new commits arrive (poller, webhook or Rescan),
# so the Git history tab stays current. The mirror is updated with `git fetch`.
HISTORY_SCAN_ON_PUSH=true
# Most recent commits to walk per scan. Raise for a complete audit of a long
# history; lower it if scans take too long on a huge monorepo.
HISTORY_MAX_COMMITS=5000
HISTORY_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Email alerts
# ---------------------------------------------------------------------------
# Port 465 = implicit SSL, 587 = STARTTLS.
# Gmail: turn on 2FA, then create an App Password and use it as SMTP_PASSWORD
#        (myaccount.google.com -> Security -> App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_STARTTLS=false        # only for a local relay without TLS
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# digest    = one email per scan listing everything that changed (default)
# per_event = one email per finding
ALERT_EMAIL_MODE=digest

# Time zone for dates in CI alerts (IANA name), e.g. Asia/Kolkata. Default UTC.
SENTINEL_TIMEZONE=

# ---------------------------------------------------------------------------
# Custom detection rules (optional)
# ---------------------------------------------------------------------------
# Path to a .sentinel-rules.json with your own token formats (see README).
# The CLI also picks up <repo>/.sentinel-rules.json automatically.
SENTINEL_RULES_FILE=

# ---------------------------------------------------------------------------
# Other alert channels (optional)
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
